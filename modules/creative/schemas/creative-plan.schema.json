{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-studio:creative:plan:1",
  "title": "Creative plan",
  "type": "object",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["artifact_id", "path", "sha256"],
      "additionalProperties": false
    }
  },
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "target_id": {"type": "string", "minLength": 1},
    "based_on_script": {"$ref": "#/$defs/ArtifactRef"},
    "style_id": {"type": "string", "minLength": 1},
    "style_rationale": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "minLength": 1},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "content_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ArtifactRef"}},
          "visual_expression": {"type": "string", "minLength": 1},
          "asset_refs": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}},
          "asset_gaps": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["unit_id", "purpose", "content_refs", "visual_expression", "asset_refs", "asset_gaps"],
        "additionalProperties": false
      }
    },
    "confirmation_required": {"const": true}
  },
  "required": ["project_id", "target_id", "based_on_script", "style_id", "style_rationale", "direction", "units", "confirmation_required"],
  "additionalProperties": false
}
